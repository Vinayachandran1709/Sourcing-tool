{
  "python.terminal.useEnvFile": true,
  "javascript.validate.enable": true,
  "typescript.validate.enable": false,
  "files.associations": {
    "*.jsx": "javascriptreact"
  },
  "python-envs.defaultEnvManager": "ms-python.python:venv",
  "python.defaultInterpreterPath": "${workspaceFolder}/backend folder/venv/Scripts/python.exe",
  "python.analysis.extraPaths": [
    "${workspaceFolder}/backend folder"
  ],
  "python.analysis.venvPath": "${workspaceFolder}/backend folder",
  "python.analysis.venv": "venv"
}
